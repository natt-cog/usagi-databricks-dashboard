{
  "datasets": [
    {
      "name": "orders",
      "displayName": "受注明細（顧客・地域付き）",
      "queryLines": [
        "SELECT\n",
        "  o.o_orderkey AS order_key,\n",
        "  o.o_orderdate AS order_date,\n",
        "  o.o_totalprice AS total_price,\n",
        "  CASE o.o_orderstatus WHEN 'F' THEN '出荷済' WHEN 'O' THEN '未出荷' WHEN 'P' THEN '一部出荷' END AS order_status,\n",
        "  o.o_orderpriority AS order_priority,\n",
        "  o.o_custkey AS customer_key,\n",
        "  CASE c.c_mktsegment WHEN 'BUILDING' THEN '建設' WHEN 'MACHINERY' THEN '機械' WHEN 'AUTOMOBILE' THEN '自動車' WHEN 'HOUSEHOLD' THEN '家庭用品' WHEN 'FURNITURE' THEN '家具' END AS segment,\n",
        "  n.n_name AS nation,\n",
        "  CASE r.r_name WHEN 'AFRICA' THEN 'アフリカ' WHEN 'AMERICA' THEN '米州' WHEN 'ASIA' THEN 'アジア' WHEN 'EUROPE' THEN '欧州' WHEN 'MIDDLE EAST' THEN '中東' END AS region\n",
        "FROM samples.tpch.orders o\n",
        "JOIN samples.tpch.customer c ON o.o_custkey = c.c_custkey\n",
        "JOIN samples.tpch.nation n ON c.c_nationkey = n.n_nationkey\n",
        "JOIN samples.tpch.region r ON n.n_regionkey = r.r_regionkey\n",
        "WHERE o.o_orderdate < DATE'1998-08-01'\n"
      ]
    },
    {
      "name": "shipping",
      "displayName": "出荷モード別 月次実績",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('MONTH', l_shipdate) AS ship_month,\n",
        "  l_shipmode AS ship_mode,\n",
        "  count(*) AS line_count,\n",
        "  sum(l_extendedprice * (1 - l_discount)) AS net_revenue,\n",
        "  sum(CASE WHEN l_receiptdate > l_commitdate THEN 1 ELSE 0 END) AS late_count\n",
        "FROM samples.tpch.lineitem\n",
        "WHERE l_shipdate < DATE'1998-08-01'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "top_customers",
      "displayName": "顧客別売上",
      "queryLines": [
        "SELECT\n",
        "  c.c_name AS customer_name,\n",
        "  n.n_name AS nation,\n",
        "  CASE r.r_name WHEN 'AFRICA' THEN 'アフリカ' WHEN 'AMERICA' THEN '米州' WHEN 'ASIA' THEN 'アジア' WHEN 'EUROPE' THEN '欧州' WHEN 'MIDDLE EAST' THEN '中東' END AS region,\n",
        "  CASE c.c_mktsegment WHEN 'BUILDING' THEN '建設' WHEN 'MACHINERY' THEN '機械' WHEN 'AUTOMOBILE' THEN '自動車' WHEN 'HOUSEHOLD' THEN '家庭用品' WHEN 'FURNITURE' THEN '家具' END AS segment,\n",
        "  count(*) AS order_count,\n",
        "  sum(o.o_totalprice) AS revenue\n",
        "FROM samples.tpch.orders o\n",
        "JOIN samples.tpch.customer c ON o.o_custkey = c.c_custkey\n",
        "JOIN samples.tpch.nation n ON c.c_nationkey = n.n_nationkey\n",
        "JOIN samples.tpch.region r ON n.n_regionkey = r.r_regionkey\n",
        "WHERE o.o_orderdate < DATE'1998-08-01'\n",
        "GROUP BY ALL\n",
        "ORDER BY revenue DESC\n",
        "LIMIT 100\n"
      ]
    }
  ],
